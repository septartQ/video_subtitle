# 翻译平台选择（可选：bailian / siliconflow / deepseek，默认 bailian）
# 也可通过命令行 --provider 指定
TRANSLATION_PROVIDER=bailian

# 阿里云百炼 API 配置
# 获取 API Key: https://help.aliyun.com/zh/model-studio/developer-reference/get-api-key
DASHSCOPE_API_KEY=your_api_key_here

# 硅基流动 API 配置
# 获取 API Key: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your_api_key_here
# SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# DeepSeek API 配置
# 获取 API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_MODEL=deepseek-chat
